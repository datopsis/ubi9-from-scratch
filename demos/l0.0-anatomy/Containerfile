# L0.0 — the ladder floor, part one: what an image actually is.
#
# A statically linked C binary in an image that contains nothing else, built so
# there is exactly one file to find when you take the archive apart by hand.
#
# The program is deliberately trivial. This rung is about the anatomy of an
# image — the manifest, the config, the layer — and about the difference
# between what an image contains and what a container has at runtime.

ARG BUILDER=registry.access.redhat.com/ubi9/ubi:9.8

FROM ${BUILDER} AS build

# glibc-static and libstdc++-static live in CodeReady Builder, which the UBI
# repo definition enables by default. Without them, -static silently falls back
# to dynamic linking for the missing pieces.
RUN dnf install -y --nodocs --setopt install_weak_deps=false \
      gcc glibc-static \
    && dnf clean all

COPY src/main.c /src/main.c

# -static      : link everything, including libc
# -O2          : optimise, since the size claim should be honest about it
# -s           : strip symbols; they are debugging aids, not runtime needs
# -no-pie      : a fully static binary cannot be position-independent
RUN mkdir -p /out \
    && gcc -static -no-pie -O2 -s -o /out/app /src/main.c \
    && echo "--- linkage check ---" \
    && (ldd /out/app || true) \
    && echo "--- size ---" \
    && stat -c '%s bytes' /out/app

# Nothing from the builder survives except the binary itself.
FROM scratch
COPY --from=build /out/app /app

# Run as a non-root uid. There is no /etc/passwd in this image, so the uid has
# no name behind it — which is fine, and is what "numeric uid" means in
# practice. Declaring it means the container does not default to uid 0 even
# when the runtime would allow it.
USER 1000:1000

ENTRYPOINT ["/app"]

LABEL rung="L0.0" \
      name="ubi9-from-scratch-l0.0-anatomy" \
      summary="A one-file image, for taking apart by hand" \
      description="One file. No libc, no shell, no package manager."
